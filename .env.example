# ==========================================
# 1. KONFIGURASI DATABASE POSTGRESQL
# ==========================================
# CARA MENGISI:
# Ganti "password_anda_disini" dengan password PostgreSQL Anda.
# Jika username Anda bukan postgres, ganti juga kata "postgres" pertama.
#
DATABASE_URL="postgresql://postgres:password_anda_disini@localhost:5432/kopdes_merah_putih?schema=public"


# ==========================================
# 2. KONFIGURASI KEAMANAN (JWT)
# ==========================================
JWT_SECRET="kopdes-merah-putih-jwt-secret-2024-gemastik"
JWT_EXPIRES_IN="7d"


# ==========================================
# 3. KONFIGURASI BACKEND API (Express.js)
# ==========================================
API_PORT=5000
API_URL="http://localhost:5000"


# ==========================================
# 4. KONFIGURASI NEXT.JS FRONTEND
# ==========================================
NEXT_PUBLIC_API_URL="http://localhost:5000/api"


# ==========================================
# 5. KONFIGURASI CLOUDINARY (Untuk Upload Foto)
# ==========================================
# (Bisa dikosongkan sementara jika belum punya)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"


# ==========================================
# 6. KONFIGURASI EMAIL SMTP (Opsional)
# ==========================================
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
